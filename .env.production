# 生产环境配置模板
TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_REGION=ap-beijing

BAIDU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BAIDU_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NODE_ENV=production
API_BASE_URL=https://your-production-domain.com

# 安全配置 - 请使用强密钥
ENCRYPTION_KEY=your_production_32_character_key
JWT_SECRET=your_production_jwt_secret_key
API_KEY=your_production_api_key

# 服务器配置
PORT=3001
ALLOWED_ORIGINS=https://your-app-domain.com,https://your-admin-domain.com

# 文件上传限制
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# 日志配置
LOG_LEVEL=info
LOG_FILE=/var/log/ocr-api.log
