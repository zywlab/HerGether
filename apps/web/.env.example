# 她聚后端服务环境变量配置
# 复制此文件为 .env 并填入实际的配置值

# 服务配置
NODE_ENV=development
PORT=3000

# 微信小程序配置
# 请到微信公众平台获取您的小程序 AppID 和 AppSecret
WECHAT_APP_ID=your_wechat_miniprogram_app_id
WECHAT_APP_SECRET=your_wechat_miniprogram_app_secret

# JWT 密钥配置
# 请使用强密码，建议使用随机生成的32位字符串
JWT_SECRET=your_super_secret_jwt_key_here_32_chars

# 管理员配置
# 初始管理员的微信 openId，多个用逗号分隔
# 这些 openId 在系统启动时会自动添加为管理员
INITIAL_ADMIN_OPENIDS=openid1,openid2,openid3

# 开发环境配置
# 在开发环境中是否跳过微信登录验证（用于测试）
SKIP_WECHAT_AUTH=true

# 数据库配置（可选）
# 如果使用 MongoDB 存储管理员数据
MONGODB_URL=mongodb://localhost:27017/shejuu

# 如果使用 MySQL 存储管理员数据  
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=shejuu

# 安全配置
# 启用管理员操作审计日志
ENABLE_AUDIT_LOG=true

# CORS 配置
# 允许的前端域名，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# 文件上传配置
MAX_FILE_SIZE=10mb

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log
